pkgbase = eirikr-crash-forensics
	pkgdesc = Arm pstore-RAM console capture, netconsole and a readable panic on this workstation, reversibly
	pkgver = 1.2.0
	pkgrel = 1
	url = https://github.com/Oichkatzelesfrettschen/PKGBUILDS
	install = eirikr-crash-forensics.install
	arch = any
	license = GPL-3.0-or-later
	checkdepends = shellcheck
	checkdepends = dash
	depends = kdumpst
	depends = systemd
	depends = iproute2
	depends = iputils
	optdepends = limine: boot entries are regenerated with limine-update when present
	backup = etc/sysctl.d/99-panic-readable.conf
	backup = etc/kdumpst.d/50-pstore-only.conf
	backup = etc/modprobe.d/50-ramoops-console.conf
	backup = etc/eirikr-crash-forensics/netconsole.conf
	source = kernel-cmdline-tool.sh
	source = test-cmdline-tool.sh
	source = save-console-record.sh
	source = netconsole-target.sh
	source = 99-panic-readable.conf
	source = 50-pstore-only.conf
	source = 50-ramoops-console.conf
	source = netconsole.conf
	source = eirikr-pstore-console-save.service
	source = netconsole-hangcapture.service
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP

pkgname = eirikr-crash-forensics
