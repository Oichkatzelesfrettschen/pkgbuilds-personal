# Maintainer: Oichkatzelesfrettschen <151315375+Oichkatzelesfrettschen@users.noreply.github.com>
pkgname=custom-fast-temporary-directories
pkgver=1.1.0
pkgrel=1
pkgdesc="Separate disk-backed /tmp and reboot-persistent /var/tmp mounts"
arch=('any')
url="https://github.com/oaich/custom-fast-temporary-directories"
license=('GPL-3.0-only')
depends=('bash' 'coreutils' 'findutils' 'systemd' 'util-linux')
# Named private-fast-temporary-directories through 1.0.0. pre_install accepts
# the already-split live layout, and the preparation script adopts the former
# layout marker on the storage root.
provides=('private-fast-temporary-directories')
conflicts=('private-fast-temporary-directories')
replaces=('private-fast-temporary-directories')
backup=(
  'etc/systemd/system/tmp.mount'
  'etc/tmpfiles.d/tmp.conf'
)
source=(
  'srv-fasttmp.mount'
  'custom-fast-temporary-directories-prepare.service'
  'tmp.mount'
  'var-tmp.mount'
  'tmp.conf'
  'custom-fast-temporary-directories-prepare'
  'custom-fast-temporary-directories-migrate-config'
  'custom-fast-temporary-directories-verify'
  'custom-fast-temporary-directories.install'
  'README.md'
  'test-layout.sh'
  'test-unit-graph.sh'
  'test-verifier.sh'
)
