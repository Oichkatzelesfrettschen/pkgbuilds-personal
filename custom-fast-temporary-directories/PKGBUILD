install='custom-fast-temporary-directories.install'

check() {
  bash -n \
    custom-fast-temporary-directories-prepare \
    custom-fast-temporary-directories-migrate-config \
    custom-fast-temporary-directories-verify \
    custom-fast-temporary-directories.install \
    test-layout.sh \
    test-unit-graph.sh \
    test-verifier.sh

  shellcheck -S warning \
    custom-fast-temporary-directories-prepare \
    custom-fast-temporary-directories-migrate-config \
    custom-fast-temporary-directories-verify \
    custom-fast-temporary-directories.install \
    test-layout.sh \
    test-unit-graph.sh \
    test-verifier.sh

  bash test-layout.sh
  bash test-unit-graph.sh
  bash test-verifier.sh
}

package() {
  install -Dm644 srv-fasttmp.mount \
    "${pkgdir}/usr/lib/systemd/system/srv-fasttmp.mount"
  install -Dm644 custom-fast-temporary-directories-prepare.service \
    "${pkgdir}/usr/lib/systemd/system/custom-fast-temporary-directories-prepare.service"
  install -Dm644 tmp.mount \
    "${pkgdir}/etc/systemd/system/tmp.mount"
  install -Dm644 var-tmp.mount \
    "${pkgdir}/usr/lib/systemd/system/var-tmp.mount"
  install -Dm644 tmp.conf \
    "${pkgdir}/etc/tmpfiles.d/tmp.conf"

  install -Dm755 custom-fast-temporary-directories-prepare \
    "${pkgdir}/usr/lib/custom-fast-temporary-directories/prepare"
  install -Dm755 custom-fast-temporary-directories-migrate-config \
    "${pkgdir}/usr/bin/custom-fast-temporary-directories-migrate-config"
  install -Dm755 custom-fast-temporary-directories-verify \
    "${pkgdir}/usr/bin/custom-fast-temporary-directories-verify"
  install -Dm644 README.md \
    "${pkgdir}/usr/share/doc/custom-fast-temporary-directories/README.md"
}
