[Unit]
Description=Fast storage backing temporary directories
Documentation=file:/usr/share/doc/custom-fast-temporary-directories/README.md
Before=local-fs.target

[Mount]
What=/dev/disk/by-uuid/f80f3ba8-49f9-46ae-9101-c8638f017a64
Where=/srv/fasttmp
Type=ext4
Options=rw,nosuid,nodev,relatime
DirectoryMode=0755

[Install]
WantedBy=local-fs.target
