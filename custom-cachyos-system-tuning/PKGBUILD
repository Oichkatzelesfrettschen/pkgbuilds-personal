# Maintainer: Oichkatzelesfrettschen <151315375+Oichkatzelesfrettschen@users.noreply.github.com>
pkgname=custom-cachyos-system-tuning
pkgver=1.12.0
pkgrel=1
pkgdesc="Workstation pressure policy: bounded memory, storage inventory, scratch, and derived caches"
arch=('any')
url="https://github.com/oaich/custom-cachyos-system-tuning"
license=('GPL-3.0-only')
# Every dependency is consumed by a script or unit rather than linked, so
# namcap's ELF-linkage dependency check reports each one as "may not be
# needed". Consumers: bash (bounded-workload, storage-inventory), systemd (units,
# oomd drop-ins, zswap tmpfiles), util-linux (swapon, mkswap, fallocate, blkid
# in ensure-fast-swapfile and the .install), procps-ng (sysctl in the .install),
# zram-generator (zram-generator.conf, which disables its device),
# cachyos-settings (the baseline these drop-ins override), pacman-contrib
# (paccache in the retention service).
depends=('bash' 'systemd' 'util-linux' 'procps-ng' 'zram-generator' 'cachyos-settings' 'pacman-contrib')
optdepends=('docker: daily bounded Docker builder-cache retention'
            'lm_sensors: applies the sensors.d jc42 limits at boot and on install')
# The package was named private-cachyos-system-tuning through 1.11.0. Its
# removal scriptlet runs before this package installs (libalpm sync.c removes
# conflicting and replaced packages first); the .install records what it does
# and how post_install restores the state it changes.
provides=('eirikr-system-tuning' 'private-cachyos-system-tuning')
conflicts=('eirikr-system-tuning' 'private-cachyos-system-tuning')
replaces=('eirikr-system-tuning' 'private-cachyos-system-tuning')

backup=(
  'etc/sysctl.d/99-swap-reclaim.conf'
  'etc/sysctl.d/99-vfs-cache-pressure.conf'
  'etc/sysctl.d/99-free-memory-reserve.conf'
  'etc/sysctl.d/99-max-map-count.conf'
  'etc/systemd/zram-generator.conf'
  'etc/sysctl.d/99-inotify-limits.conf'
  'etc/sensors.d/tuf-b550-nct6798.conf'
)
source=(
  '99-swap-reclaim.conf'
  '99-vfs-cache-pressure.conf'
  '99-free-memory-reserve.conf'
  '99-max-map-count.conf'
  'zram-generator.conf'
  'oomd-swap-limit.conf'
  'managed-oom-swap.conf'
  'bounded-workload.slice'
  'bounded-workload'
  'storage-inventory'
  'srv-scratch.conf'
  'custom-paccache-retention.service'
  'custom-paccache-retention.timer'
  'custom-docker-build-cache-retention.service'
  'custom-docker-build-cache-retention.timer'
  'journald-retention.conf'
  'coredump-limits.conf'
  'logind-no-idle-suspend.conf'
  'sleep-no-sleep.conf'
  'ensure-fast-swapfile'
  'custom-fast-swapfile.service'
  'srv-fasttmp-swapfile.swap'
  'zswap.conf'
  'bounded-build.slice'
  'README.md'
  'SYSTEM.md'
  '99-inotify-limits.conf'
  'tuf-b550-nct6798.conf'
  'warp-svc-log-rate.conf'
  'vmware-usbarbitrator-log-rate.conf'
  'ksmd-off.conf'
  'memory-ksm-off.conf'
)
