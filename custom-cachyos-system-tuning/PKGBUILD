            'a04fb0ea9611367b6a15e69ba9d5f64adf637a3989bdde1997e883b2090cb186')
install='custom-cachyos-system-tuning.install'

package() {
  # ===== sysctl.d: one file per concern =====
  # 99-swap-reclaim.conf: swappiness 150 and page-cluster 0 (zswap in front of
  # TLC swap, QLC filesystem). 99-vfs-cache-pressure.conf: 100 over the CachyOS
  # 50. 99-free-memory-reserve.conf: free reserve, watermark spacing and boost,
  # proactive compaction. Each header names its keys and the files it overrides.
  for _f in 99-swap-reclaim.conf 99-vfs-cache-pressure.conf 99-free-memory-reserve.conf; do
    install -Dm644 "${srcdir}/${_f}" "${pkgdir}/etc/sysctl.d/${_f}"
  done

  # ===== sysctl.d: mmap region ceiling =====
  # 99-max-map-count.conf sorts after elasticsearch's 60-elasticsearch.conf,
  # which lowers the Arch 10-arch.conf value of 1048576 to 262144.
  install -Dm644 "${srcdir}/99-max-map-count.conf" "${pkgdir}/etc/sysctl.d/99-max-map-count.conf"

  # ===== compressed tier: zswap in front of the disk swapfiles =====
  # zram-generator.conf declares no device, which shadows the cachyos-settings
  # zram0 definition; the tmpfiles file enables zswap at boot. zram at a higher
  # priority than disk swap keeps whichever pages reached it first, so hot pages
  # spilled to the QLC disk while cold desktop pages held zram. zswap writes its
  # coldest entries back to disk and keeps recent pages compressed in RAM. Both
  # changes apply at the next boot.
  install -Dm644 "${srcdir}/zram-generator.conf" "${pkgdir}/etc/systemd/zram-generator.conf"
  install -Dm644 "${srcdir}/zswap.conf" \
    "${pkgdir}/usr/lib/tmpfiles.d/${pkgname}-zswap.conf"

  # ===== the 980 PRO swap tier =====
  # The 980 PRO swapfile is the primary disk tier behind zswap. The root disk is
  # a DRAM-less QLC drive on PCIe 3.0; the 980 PRO is TLC with DRAM on PCIe 4.0
  # and carries the fast partition at /srv/fasttmp. The swapfile lives on the
  # partition root, outside the /tmp bind, so no tmpfiles cleanup reaches it. The oneshot creates the file only when it is missing;
  # the static swap.target.wants link enables the tier on install.
  install -Dm755 "${srcdir}/ensure-fast-swapfile" \
    "${pkgdir}/usr/lib/${pkgname}/ensure-fast-swapfile"
  install -Dm644 "${srcdir}/custom-fast-swapfile.service" \
    "${pkgdir}/usr/lib/systemd/system/custom-fast-swapfile.service"
  install -Dm644 "${srcdir}/srv-fasttmp-swapfile.swap" \
    "${pkgdir}/usr/lib/systemd/system/srv-fasttmp-swapfile.swap"
  install -d "${pkgdir}/usr/lib/systemd/system/swap.target.wants"
  ln -s ../srv-fasttmp-swapfile.swap \
    "${pkgdir}/usr/lib/systemd/system/swap.target.wants/srv-fasttmp-swapfile.swap"

  # ===== systemd-oomd: swap backstop near exhaustion =====
  # Swap pressure is bounded by per-workload budgets (the two bounded slices);
  # oomd's swap guard is a 90% backstop. The -.slice drop-in opts the cgroup
  # tree into it.
  install -Dm644 "${srcdir}/oomd-swap-limit.conf" \
    "${pkgdir}/usr/lib/systemd/oomd.conf.d/95-custom-cachyos-system-tuning.conf"
  install -Dm644 "${srcdir}/managed-oom-swap.conf" \
    "${pkgdir}/usr/lib/systemd/system/-.slice.d/10-managed-oom-swap.conf"

  # ===== system batch builds: a budget instead of an oomd exemption =====
  install -Dm644 "${srcdir}/bounded-build.slice" \
    "${pkgdir}/usr/lib/systemd/system/bounded-build.slice"

  # ===== user workloads: separate heavy jobs from terminal scopes =====
  install -Dm644 "${srcdir}/bounded-workload.slice" \
    "${pkgdir}/usr/lib/systemd/user/bounded-workload.slice"
  install -Dm755 "${srcdir}/bounded-workload" \
    "${pkgdir}/usr/bin/bounded-workload"
  install -Dm755 "${srcdir}/storage-inventory" \
    "${pkgdir}/usr/bin/storage-inventory"

  # ===== scratch: explicit lifecycle for service-data workspace =====
  install -Dm644 "${srcdir}/srv-scratch.conf" \
    "${pkgdir}/usr/lib/tmpfiles.d/srv-scratch.conf"

  # ===== package cache: retain rollback coverage without unbounded growth =====
  install -Dm644 "${srcdir}/custom-paccache-retention.service" \
    "${pkgdir}/usr/lib/systemd/system/custom-paccache-retention.service"
  install -Dm644 "${srcdir}/custom-paccache-retention.timer" \
    "${pkgdir}/usr/lib/systemd/system/custom-paccache-retention.timer"

  # ===== container cache: retain images, containers, and volumes =====
  install -Dm644 "${srcdir}/custom-docker-build-cache-retention.service" \
    "${pkgdir}/usr/lib/systemd/system/custom-docker-build-cache-retention.service"
  install -Dm644 "${srcdir}/custom-docker-build-cache-retention.timer" \
    "${pkgdir}/usr/lib/systemd/system/custom-docker-build-cache-retention.timer"

  # ===== journald, coredump, logind and sleep: the daemon-config half =====
  # These four were hand-written into /etc/systemd/*.conf.d and owned by no
  # package. They are this package's policy rather than the operator's, so
  # they install under /usr/lib where an operator drop-in in /etc still wins,
  # and removing the package takes them with it.
  install -Dm644 "${srcdir}/journald-retention.conf" \
    "${pkgdir}/usr/lib/systemd/journald.conf.d/50-${pkgname}.conf"
  install -Dm644 "${srcdir}/coredump-limits.conf" \
    "${pkgdir}/usr/lib/systemd/coredump.conf.d/50-${pkgname}.conf"
  install -Dm644 "${srcdir}/logind-no-idle-suspend.conf" \
    "${pkgdir}/usr/lib/systemd/logind.conf.d/90-${pkgname}.conf"
  install -Dm644 "${srcdir}/sleep-no-sleep.conf" \
    "${pkgdir}/usr/lib/systemd/sleep.conf.d/90-${pkgname}.conf"

  # ===== journald: per-unit rate limits for the two noisiest system units =====
  # Only the system manager exports LogRateLimit* and LogLevelMax to journald
  # (unit_export_state_files in src/core/unit.c returns early for a user
  # manager), so a user-unit drop-in would be inert; user units are an operator
  # decision recorded in SYSTEM.md.
  install -Dm644 "${srcdir}/warp-svc-log-rate.conf" \
    "${pkgdir}/usr/lib/systemd/system/warp-svc.service.d/50-${pkgname}.conf"
  install -Dm644 "${srcdir}/vmware-usbarbitrator-log-rate.conf" \
    "${pkgdir}/usr/lib/systemd/system/vmware-usbarbitrator.service.d/50-${pkgname}.conf"

  # ===== KSM off: both layers cachyos-ksm-settings enables =====
  install -Dm644 "${srcdir}/ksmd-off.conf" \
    "${pkgdir}/usr/lib/systemd/system/ksmd.service.d/90-${pkgname}.conf"
  for _unit in user@.service gdm.service getty@.service; do
    install -Dm644 "${srcdir}/memory-ksm-off.conf" \
      "${pkgdir}/usr/lib/systemd/system/${_unit}.d/90-${pkgname}.conf"
  done

  # ===== inotify ceilings: one owned file replaces three unowned ones =====
  install -Dm644 "${srcdir}/99-inotify-limits.conf" "${pkgdir}/etc/sysctl.d/99-inotify-limits.conf"

  # ===== board sensors: NCT6798D labels and DDR4 jc42 limits =====
  # lm_sensors.service runs 'sensors -s' at boot, which writes the jc42 set lines.
  install -Dm644 "${srcdir}/tuf-b550-nct6798.conf" "${pkgdir}/etc/sensors.d/tuf-b550-nct6798.conf"

  # ===== documentation referenced by the units' Documentation= =====
  install -Dm644 "${srcdir}/README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 "${srcdir}/SYSTEM.md" "${pkgdir}/usr/share/doc/${pkgname}/SYSTEM.md"
}
