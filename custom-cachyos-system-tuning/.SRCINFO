pkgbase = custom-cachyos-system-tuning
	pkgdesc = Workstation pressure policy: bounded memory, storage inventory, scratch, and derived caches
	pkgver = 1.12.0
	pkgrel = 1
	url = https://github.com/oaich/custom-cachyos-system-tuning
	install = custom-cachyos-system-tuning.install
	arch = any
	license = GPL-3.0-only
	depends = bash
	depends = systemd
	depends = util-linux
	depends = procps-ng
	depends = zram-generator
	depends = cachyos-settings
	depends = pacman-contrib
	optdepends = docker: daily bounded Docker builder-cache retention
	optdepends = lm_sensors: applies the sensors.d jc42 limits at boot and on install
	provides = eirikr-system-tuning
	provides = private-cachyos-system-tuning
