pkgbase = eirikr-network
	pkgdesc = Wired link tuning, ethernet priority, BBR, and the resolved policy that leaves mDNS to avahi
	pkgver = 1.1.0
	pkgrel = 1
	url = https://github.com/Oichkatzelesfrettschen/PKGBUILDS
	install = eirikr-network.install
	arch = any
	license = GPL-3.0-or-later
	checkdepends = shellcheck
	checkdepends = bash
	depends = systemd
	optdepends = networkmanager: the ethernet priority drop-in applies to it
	optdepends = avahi: owns mDNS under this resolved policy
	optdepends = iw: the regulatory domain helper falls back to it
	provides = eirikr-network-config
	provides = eirikr-network-fixes
	conflicts = eirikr-network-config
	conflicts = eirikr-network-fixes
	replaces = eirikr-network-config
	replaces = eirikr-network-fixes
	backup = etc/sysctl.d/99-network-performance.conf
	backup = etc/NetworkManager/conf.d/99-ethernet-priority.conf
	backup = etc/NetworkManager/conf.d/20-wifi-performance.conf
	backup = etc/NetworkManager/conf.d/20-dns-systemd-resolved.conf
	backup = etc/NetworkManager/conf.d/20-ignore-wifi-p2p.conf
	backup = etc/modules-load.d/tcp-bbr.conf
	backup = etc/modules-load.d/netfilter.conf
	backup = etc/systemd/resolved.conf.d/90-avahi-primary.conf
	source = 99-network-performance.conf
	source = 99-ethernet-priority.conf
	source = wifi-performance.conf
	source = dns-systemd-resolved.conf
	source = 20-ignore-wifi-p2p.conf
	source = tcp-bbr.conf
	source = netfilter.conf
	source = 90-avahi-primary.conf
	source = regulatory-domain.sh
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP

