pkgbase = eirikr-nvidia-tuning
	pkgdesc = Workstation NVIDIA driver hygiene: desktop-safe modprobe options, single-DRM-provider blacklists, and GL and VA-API session env. Replaces the unowned /etc/profile.d and /etc/modprobe.d hand-edits.
	pkgver = 1.3.0
	pkgrel = 1
	url = https://github.com/oaich/eirikr-nvidia-tuning
	install = eirikr-nvidia-tuning.install
	arch = any
	license = GPL-3.0-or-later
	depends = nvidia-utils
	depends = acl
	optdepends = libva-nvidia-driver: needed for the LIBVA_DRIVER_NAME=nvidia env to resolve
	optdepends = cachyos-settings: ships /usr/lib/modprobe.d/nvidia.conf which our /etc/ override shadows
	backup = etc/modprobe.d/nvidia.conf
	backup = etc/modprobe.d/tty-only-nvidia.conf
	backup = etc/modprobe.d/nouveau-blacklist.conf
	backup = etc/modprobe.d/nvidia-uvm-sam.conf
	source = nvidia.conf
	source = tty-only-nvidia.conf
	source = nouveau-blacklist.conf
	source = 60-eirikr-nvidia.conf
	source = nvidia-uvm-sam.conf
	source = nvidia-profiler-device-setup.sh
	source = nvidia-profiler-device.service
	source = nvidia-profiler-sysusers.conf
