post_install() {
  printf '%s\n' ""
  printf '%s\n' "=== source-analysis-mcp installed ==="
  printf '%s\n' ""
  printf '%s\n' "Server command:"
  printf '%s\n' "  /usr/bin/source-analysis-mcp serve"
  printf '%s\n' ""
  printf '%s\n' "Preview Codex and Claude registration:"
  printf '%s\n' "  source-analysis-mcp-register --client both --mode dry-run"
  printf '%s\n' ""
  printf '%s\n' "Apply Codex and Claude registration as your user:"
  printf '%s\n' "  source-analysis-mcp-register --client both --mode apply"
  printf '%s\n' ""
  printf '%s\n' "Verify:"
  printf '%s\n' "  source-analysis-mcp doctor"
  printf '%s\n' "  codex mcp list"
  printf '%s\n' "  claude mcp list"
  printf '%s\n' ""
  printf '%s\n' "Examples:"
  printf '%s\n' "  /usr/share/source-analysis-mcp/examples/"
  printf '%s\n' ""
}

post_upgrade() {
  post_install
}

post_remove() {
  printf '%s\n' ""
  printf '%s\n' "=== source-analysis-mcp removed ==="
  printf '%s\n' ""
  printf '%s\n' "Client registrations are not removed automatically."
  printf '%s\n' "Remove them with:"
  printf '%s\n' "  codex mcp remove source-analysis"
  printf '%s\n' "  claude mcp remove source-analysis --scope user"
  printf '%s\n' ""
}
