pkgbase = source-analysis-mcp
	pkgdesc = Unified local MCP server for source analysis, static analysis, binary inspection, tracing, and fuzzing
	pkgver = 0.2.0
	pkgrel = 1
	url = https://modelcontextprotocol.io
	install = source-analysis-mcp.install
	arch = any
	license = MIT
	checkdepends = python-pytest
	checkdepends = python-ruff
	makedepends = python-build
	makedepends = python-installer
	makedepends = python-wheel
	depends = python>=3.12
	depends = python-mcp>=2.3.0
	depends = python-pydantic
	depends = python-tomlkit
	optdepends = ripgrep: fast text search
	optdepends = git: tracked source search
	optdepends = ctags: tag generation and readtags
	optdepends = global: GNU Global gtags/global cross references
	optdepends = cscope: C cross-reference database
	optdepends = cflow: C call graph sketches
	optdepends = ast-grep: syntax-aware source search
	optdepends = tree-sitter-cli: syntax tree parsing and queries
	optdepends = semgrep: semantic rule scans
	optdepends = comby: structural search and rewrite
	optdepends = coccinelle-bin: Coccinelle spatch semantic patching
	optdepends = cppcheck: C/C++ static analysis
	optdepends = clang: clang-tidy and scan-build
	optdepends = sparse: sparse static analysis
	optdepends = smatch: smatch C static analysis
	optdepends = infer-static: Infer interprocedural static analysis
	optdepends = codeql: CodeQL database and query analysis
	optdepends = lizard: complexity metrics
	optdepends = scc: source code counting
	optdepends = cloc: source code counting
	optdepends = binutils: readelf, nm, objdump, addr2line
	optdepends = gdb: batch debugger and symbolization
	optdepends = strace: syscall tracing
	optdepends = ltrace: dynamic library tracing
	optdepends = radare2: r2 and radiff2 binary analysis
	optdepends = rizin: Rizin binary analysis
	optdepends = binwalk: firmware and container scanning
	optdepends = ghidra: headless reverse engineering
	optdepends = python-lief: binary format inspection
	optdepends = bpftrace: eBPF tracing
	optdepends = bcc-libbpf-tools: BCC tracing tools
	optdepends = trace-cmd: ftrace capture
	optdepends = lttng-tools-generic-kernel: LTTng tracing
	optdepends = systemtap: SystemTap probes
	optdepends = perfetto: timeline traces
	optdepends = sysprof: profiling captures
	optdepends = heaptrack: heap allocation profiling
	optdepends = valgrind: callgrind and instrumentation
	optdepends = hotspot: callgrind viewer
	optdepends = radamsa: mutation testing
	optdepends = afl++: coverage-guided fuzzing
	optdepends = honggfuzz: coverage-guided fuzzing
	optdepends = python-frida-tools: Frida CLI and Python instrumentation
	optdepends = python-ptrace: ptrace-based Python probes
	optdepends = joern: code property graph parsing and scanning

pkgname = source-analysis-mcp
