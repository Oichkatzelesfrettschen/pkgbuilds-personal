# Maintainer: Oichkatzelesfrettschen <151315375+Oichkatzelesfrettschen@users.noreply.github.com>
pkgname=source-analysis-mcp
pkgver=0.2.0
pkgrel=1
pkgdesc="Unified local MCP server for source analysis, static analysis, binary inspection, tracing, and fuzzing"
arch=('any')
url="https://modelcontextprotocol.io"
license=('MIT')
depends=(
  'python>=3.12'
  'python-mcp>=2.3.0'
  'python-pydantic'
  'python-tomlkit'
)
makedepends=(
  'python-build'
  'python-installer'
  'python-wheel'
)
checkdepends=(
  'python-pytest'
  'python-ruff'
)
optdepends=(
  'ripgrep: fast text search'
  'git: tracked source search'
  'ctags: tag generation and readtags'
  'global: GNU Global gtags/global cross references'
  'cscope: C cross-reference database'
  'cflow: C call graph sketches'
  'ast-grep: syntax-aware source search'
  'tree-sitter-cli: syntax tree parsing and queries'
  'semgrep: semantic rule scans'
  'comby: structural search and rewrite'
  'coccinelle-bin: Coccinelle spatch semantic patching'
  'cppcheck: C/C++ static analysis'
  'clang: clang-tidy and scan-build'
  'sparse: sparse static analysis'
  'smatch: smatch C static analysis'
  'infer-static: Infer interprocedural static analysis'
  'codeql: CodeQL database and query analysis'
  'lizard: complexity metrics'
  'scc: source code counting'
  'cloc: source code counting'
  'binutils: readelf, nm, objdump, addr2line'
  'gdb: batch debugger and symbolization'
  'strace: syscall tracing'
  'ltrace: dynamic library tracing'
  'radare2: r2 and radiff2 binary analysis'
  'rizin: Rizin binary analysis'
  'binwalk: firmware and container scanning'
  'ghidra: headless reverse engineering'
  'python-lief: binary format inspection'
  'bpftrace: eBPF tracing'
  'bcc-libbpf-tools: BCC tracing tools'
  'trace-cmd: ftrace capture'
  'lttng-tools-generic-kernel: LTTng tracing'
  'systemtap: SystemTap probes'
  'perfetto: timeline traces'
  'sysprof: profiling captures'
  'heaptrack: heap allocation profiling'
  'valgrind: callgrind and instrumentation'
  'hotspot: callgrind viewer'
  'radamsa: mutation testing'
  'afl++: coverage-guided fuzzing'
  'honggfuzz: coverage-guided fuzzing'
  'python-frida-tools: Frida CLI and Python instrumentation'
  'python-ptrace: ptrace-based Python probes'
  'joern: code property graph parsing and scanning'
)
source=()
sha256sums=()
install="${pkgname}.install"

_pkgroot="${startdir}"

build() {
  cd "${_pkgroot}"
  python -m build --wheel --no-isolation
}

check() {
  cd "${_pkgroot}"
  ruff check source_analysis_mcp tests
  pytest
}

package() {
  cd "${_pkgroot}"
  python -m installer --destdir="${pkgdir}" dist/*.whl

  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 examples/codex.config.toml \
    "${pkgdir}/usr/share/${pkgname}/examples/codex.config.toml"
  install -Dm644 examples/claude.mcp.json \
    "${pkgdir}/usr/share/${pkgname}/examples/claude.mcp.json"
}
