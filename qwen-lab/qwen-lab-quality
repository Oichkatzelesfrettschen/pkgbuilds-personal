def build_hard(retrieval_sentences):
    """Tasks built to separate two checkpoints that both clear the standard tier.

    Each one fails on a single slip rather than degrading gracefully: an
    arithmetic chain where any step poisons the result, code with edge cases a
    plausible-looking implementation gets wrong, six simultaneous constraints,
    and retrieval that requires binding three values to three entities against
    distractors that differ only in the entity name.
    """
    needles = [(0.15, "The calibration constant for the Alpha thermal bridge is 4471."),
               (0.55, "The calibration constant for the bravo thermal bridge is 9382."),
               (0.85, "The calibration constant for the Bobcat thermal bridge is 2605.")]
    distractors = [(0.30, "The calibration constant for the Alpha optical bridge is 1111."),
                   (0.70, "The retirement constant for the bravo thermal bridge is 2222."),
                   (0.95, "The calibration constant for the Bobcat thermal relay is 3333.")]
    hay = _multi_needle(retrieval_sentences, needles, distractors, 21)

    return [
        dict(id="hard-code-median", category="code", max_tokens=3072,
             prompt="Write a Python function `running_median(nums)` returning a list "
                    "where element i is the median of nums[0..i] inclusive. For an "
                    "even count the median is the mean of the two middle values, as a "
                    "float when they differ. `running_median([1,2,3])` must return "
                    "[1, 1.5, 2]. Handle an empty list. Reply with the function in a "
                    "single Python code block.",
             scorer="code",
             spec={"test": "assert running_median([1,2,3]) == [1, 1.5, 2]\n"
                           "assert running_median([]) == []\n"
                           "assert running_median([5]) == [5]\n"
                           "assert running_median([2,1]) == [2, 1.5]\n"
                           "assert running_median([1,1,1,1]) == [1,1,1,1]\n"
                           "assert running_median([3,-1,4,-1,5]) == [3, 1.0, 3, 1.0, 3]"}),
        dict(id="hard-code-stable", category="code", max_tokens=3072,
             prompt="Write a Python function `rank(rows)` taking a list of "
                    "(name, score) tuples and returning names sorted by descending "
                    "score, ties broken by original order rather than by name. "
                    "`rank([('a',1),('b',2),('c',1)])` must return ['b','a','c']. "
                    "Reply with the function in a single Python code block.",
             scorer="code",
             spec={"test": "assert rank([('a',1),('b',2),('c',1)]) == ['b','a','c']\n"
                           "assert rank([]) == []\n"
                           "assert rank([('z',5),('y',5)]) == ['z','y']\n"
                           "assert rank([('p',0),('q',-1),('r',3)]) == ['r','p','q']"}),

        dict(id="hard-reason-chain", category="reasoning", max_tokens=3072,
             prompt="A card holds 12282 MiB. A compositor holds 1542. A checkpoint "
                    "takes 9216 MiB and its compute buffers take 504. The remaining "
                    "space is used for a cache costing 34 KiB per token, where "
                    "1 MiB is 1024 KiB. How many whole tokens of cache fit? End your "
                    "reply with that number alone on the final line.",
             scorer="exact", spec={"answer": "30720"}),
        dict(id="hard-reason-ratio", category="reasoning", max_tokens=3072,
             prompt="Arm one runs at 0.932 of a ceiling of 24.06 divided by 8.774. "
                    "Arm two runs at 0.615 of a ceiling of 35.21 divided by 5.665. "
                    "By what factor is arm two faster than arm one? Give three "
                    "decimal places and end your reply with that number alone on the "
                    "final line.",
             scorer="exact", spec={"answer": "1.496"}),

        dict(id="hard-json-deep", category="structured", max_tokens=3072,
             prompt="Return a single JSON object and nothing else with keys `arm` "
                    "(string \"split\"), `blocks` (integer 38), `bytes_per_token` "
                    "(number 5.665), `links` (a list of exactly two objects, each "
                    "with keys `name` and `gib_s`, the first being \"ddr4\" at "
                    "35.21 and the second \"pcie\" at 24.06), and `resident` "
                    "(boolean false). Output only the JSON.",
             scorer="json",
             spec={"required": ["arm", "blocks", "bytes_per_token", "links", "resident"],
                   "values": {"arm": "split", "blocks": 38, "resident": "False"},
                   "types": {"links": "list", "blocks": "int"}}),

        dict(id="hard-follow-stack", category="adherence", max_tokens=3072,
             prompt="Write exactly five lines. Every line must start with 'R' and end "
                    "with a period. No line may contain a comma. Do not use the words "
                    "'the', 'is', or 'and' anywhere. Use no more than seventy words in "
                    "total. Output only those five lines.",
             scorer="constraints",
             spec={"line_count": 5, "prefix": "R", "suffix": ".", "max_words": 70,
                   "forbidden_chars": [","], "forbidden": ["the", "is", "and"]}),

        *[dict(id=f"hard-recall-{who}", category="retrieval", max_tokens=768,
               prompt=("Read the following log and answer the question at the end.\n\n"
                       + hay + f"\n\nQuestion: What is the calibration constant for "
                       f"the {who} thermal bridge? Reply with the number only."),
               scorer="exact", spec={"answer": val})
          for who, val in (("Alpha", "4471"), ("bravo", "9382"), ("Bobcat", "2605"))],
    ]


# --------------------------------------------------------------------------
# transport
# --------------------------------------------------------------------------

def server_props(base_url, timeout=15):
    """What the server says it is serving, so the report is self-describing.

    Two arms are only comparable when they ran the same context and the same
    chat template, and both are properties of the running server rather than of
    the command that started it. Recording them here lets the comparison refuse
    a mismatched pair instead of averaging one. llama.cpp exposes /props;
    anything else returns nothing and the fields stay null.
    """
    import hashlib
    try:
        req = urllib.request.Request(f"{base_url.rstrip('/')}/props")
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            d = json.loads(resp.read())
    except Exception:
        return {"n_ctx": None, "model_path": None, "chat_template_sha256": None}
    tpl = d.get("chat_template") or ""
    gen = d.get("default_generation_settings") or {}
    return {
        "n_ctx": d.get("n_ctx") or gen.get("n_ctx"),
        "model_path": d.get("model_path"),
        "chat_template_sha256": (hashlib.sha256(tpl.encode()).hexdigest()
                                 if tpl else None),
    }


def ask(base_url, model, prompt, max_tokens, temperature, timeout):
    body = json.dumps({
        "model": model,
        "messages": [{"role": "user", "content": prompt}],
        "max_tokens": max_tokens,
        "temperature": temperature,
    }).encode()
    req = urllib.request.Request(f"{base_url.rstrip('/')}/v1/chat/completions",
                                 data=body,
                                 headers={"Content-Type": "application/json"})
    started = time.perf_counter()
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        payload = json.loads(resp.read())
    choice = payload["choices"][0]
    message = choice.get("message") or {}
    return {
        "content": message.get("content") or "",
        "reasoning": message.get("reasoning_content") or "",
        "finish_reason": choice.get("finish_reason"),
        "usage": payload.get("usage"),
        "wall_s": time.perf_counter() - started,
    }


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--base-url", default="http://127.0.0.1:8803")
    ap.add_argument("--model", required=True)
    ap.add_argument("--label", required=True)
    ap.add_argument("--temperature", type=float, default=0.0)
    ap.add_argument("--timeout", type=float, default=3600.0)
    ap.add_argument("--retrieval-sentences", type=int, default=1180,
                    help="filler length; about 20 tokens per sentence")
    ap.add_argument("--tier", default="standard",
                    choices=("standard", "hard", "all"),
                    help="hard adds tasks that separate checkpoints both tiers pass")
    ap.add_argument("--only", default="",
                    help="comma-separated task ids or categories, for a smoke test")
    ap.add_argument("--json-out", default="")
    args = ap.parse_args()

    suite = []
    if args.tier in ("standard", "all"):
        suite += build_suite(args.retrieval_sentences)
    if args.tier in ("hard", "all"):
        suite += build_hard(args.retrieval_sentences)
    if args.only:
        wanted = {w.strip() for w in args.only.split(",")}
        suite = [t for t in suite if t["id"] in wanted or t["category"] in wanted]

    results = []
    for i, task in enumerate(suite, 1):
        print(f"[{i}/{len(suite)}] {task['id']} ...", file=sys.stderr, flush=True)
        try:
            reply = ask(args.base_url, args.model, task["prompt"],
                        task["max_tokens"], args.temperature, args.timeout)
        except (urllib.error.URLError, OSError, KeyError) as exc:
            results.append({**{k: task[k] for k in ("id", "category")},
                            "error": str(exc), "score": None, "usable": False})
            continue

        usable = reply["finish_reason"] == "stop"
        score, detail = SCORERS[task["scorer"]](reply["content"], task["spec"])
        results.append({
            "id": task["id"], "category": task["category"],
            "score": score if usable else None,
            "usable": usable,
            "detail": detail if usable else
                      f"unusable: finish_reason={reply['finish_reason']}",
            "finish_reason": reply["finish_reason"],
            "wall_s": round(reply["wall_s"], 2),
            "prompt_tokens": (reply["usage"] or {}).get("prompt_tokens"),
            "completion_tokens": (reply["usage"] or {}).get("completion_tokens"),
            "reasoning_chars": len(reply["reasoning"]),
            "answer_chars": len(reply["content"]),
            "answer": reply["content"][:600],
        })
        print(f"      score={results[-1]['score']} usable={usable} "
              f"({results[-1]['detail'][:70]})", file=sys.stderr, flush=True)

    scored = [r for r in results if r["score"] is not None]
    by_category = {}
    for r in scored:
        by_category.setdefault(r["category"], []).append(r["score"])

    report = {
        "label": args.label,
        "model": args.model,
        "base_url": args.base_url,
        "suite_version": SUITE_VERSION,
        "tier": args.tier,
        "retrieval_sentences": args.retrieval_sentences,
        "server": server_props(args.base_url),
        "temperature": args.temperature,
        "tasks_total": len(results),
        "tasks_usable": len(scored),
        "unusable_ids": [r["id"] for r in results if not r["usable"]],
        # The overall figure averages categories rather than tasks, so a
        # category with more tasks does not silently outweigh the others.
        "score_overall": (round(statistics.fmean(
            [statistics.fmean(v) for v in by_category.values()]), 4)
            if by_category else None),
        "score_by_category": {k: round(statistics.fmean(v), 4)
                              for k, v in sorted(by_category.items())},
        "tasks_by_category": {k: len(v) for k, v in sorted(by_category.items())},
        "wall_s_total": round(sum(r.get("wall_s") or 0 for r in results), 1),
        "results": results,
    }
    out = json.dumps(report, indent=2)
    if args.json_out:
        with open(args.json_out, "w") as fh:
            fh.write(out + "\n")
    print(out)
    return 0


if __name__ == "__main__":
    sys.exit(main())
