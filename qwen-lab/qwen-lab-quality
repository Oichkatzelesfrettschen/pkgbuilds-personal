#!/usr/bin/env python3
"""Score one served model on tasks whose answers can be checked without a judge.

Latency picks a mechanism; quality picks a checkpoint, and the two arms this
lab ends on differ by more than speed. A fully resident 2-bit quant and a
4-bit checkpoint split across host and device produce different text, and no
amount of tokens per second says whether the difference matters.

Every scorer here is deterministic. Generated code is executed against fixed
assertions, arithmetic and logic answers are matched exactly, structured output
is parsed and its fields checked, instruction adherence is measured against
constraints a program can count, and retrieval is an exact match on a fact
placed at a known depth. A model judging a model would introduce a third
quantisation into the measurement.

Only the assistant's `content` is scored. Qwen3.8 emits its chain into
`reasoning_content`, which is recorded for diagnosis but is not the answer, and
scoring it would reward verbosity. A sample whose `finish_reason` is not
`stop` hit the token budget rather than finishing, so it is reported as
unusable rather than wrong: truncation is a harness fault and counting it as a
quality loss would blame the model for the budget.

Standard library only, so it runs against any OpenAI-compatible endpoint
without sharing a backend environment.
"""

import argparse
import json
import re
import statistics
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request

SUITE_VERSION = "4"

# --------------------------------------------------------------------------
# haystack construction for the retrieval tasks
# --------------------------------------------------------------------------

# Filler has to be prose that does not repeat: a model can skip repetition
# cheaply, and a haystack that compresses is not a haystack. The needle states
# a fact no pretraining corpus contains, so a correct answer cannot come from
# memory rather than from the context.
_TOPICS = ["the cooling loop", "the telemetry sampler", "the checkpoint loader",
           "the arbitration queue", "the batch scheduler", "the retry budget",
           "the page allocator", "the trace buffer", "the link trainer",
           "the quantisation table", "the prefetch window", "the barrier counter"]
_VERBS = ["records", "drains", "rejects", "reorders", "coalesces", "throttles",
          "mirrors", "invalidates", "promotes", "retires", "stages", "audits"]
_OBJECTS = ["stale descriptors", "partial writes", "unaligned reads", "idle credits",
            "orphaned handles", "deferred flushes", "speculative fills",
            "contended locks", "expired leases", "duplicate acknowledgements"]


def _haystack(n_sentences, needle, depth, seed=11):
    """Filler sentences with the needle inserted at a fractional depth."""
    import random
    rng = random.Random(seed)
    body = [f"In section {i + 1}, {rng.choice(_TOPICS)} {rng.choice(_VERBS)} "
            f"{rng.choice(_OBJECTS)} before the next interval begins."
            for i in range(n_sentences)]
    body.insert(max(0, min(len(body), int(len(body) * depth))), needle)
    return " ".join(body)


def _multi_needle(sentences, needles, distractors, seed):
    """Several facts at different depths, with near-miss values also present.

    A single needle rewards a model for finding the one sentence that does not
    look like filler. Distractors that differ only in the entity name make that
    strategy fail, so the model has to bind value to entity rather than spot an
    anomaly. This is where a coarse quantisation is expected to degrade first.
    """
    import random
    rng = random.Random(seed)
    body = [f"In section {i + 1}, {rng.choice(_TOPICS)} {rng.choice(_VERBS)} "
            f"{rng.choice(_OBJECTS)} before the next interval begins."
            for i in range(sentences)]
    for depth, sentence in list(needles) + list(distractors):
        body.insert(max(0, min(len(body), int(len(body) * depth))), sentence)
    return " ".join(body)


def _retrieval_task(depth, sentences, value, seed):
    needle = (f"The calibration constant for the Alpha thermal bridge is {value}.")
    text = _haystack(sentences, needle, depth, seed)
    return ("Read the following log and answer the question at the end.\n\n"
            + text
            + "\n\nQuestion: What is the calibration constant for the Alpha "
              "thermal bridge? Reply with the number only.")


# --------------------------------------------------------------------------
# scorers
# --------------------------------------------------------------------------

def _code_block(text):
    """The last fenced block, or the whole reply when the model omitted fences."""
    blocks = re.findall(r"```(?:python)?\s*\n(.*?)```", text, re.S)
    return blocks[-1] if blocks else text


def score_code(text, spec):
    """Execute the generated function against fixed assertions.

    Runs isolated (-I ignores the environment and user site) with no shell, in
    a throwaway directory, under a timeout. The prompts ask for pure functions
    over builtin types, so nothing here needs the network or the filesystem.
    """
    src = _code_block(text)
    program = src + "\n\n" + spec["test"] + "\nprint('PASS')\n"
    with tempfile.TemporaryDirectory() as d:
        path = f"{d}/candidate.py"
        with open(path, "w") as fh:
            fh.write(program)
        try:
            r = subprocess.run([sys.executable, "-I", path], capture_output=True,
                               text=True, timeout=15, cwd=d)
        except subprocess.TimeoutExpired:
            return 0.0, "timed out after 15 s"
    if r.returncode == 0 and "PASS" in r.stdout:
        return 1.0, "assertions passed"
    detail = (r.stderr.strip().splitlines() or ["no output"])[-1]
    return 0.0, detail[:180]


def score_exact(text, spec):
    """Exact match on a normalised final answer."""
    got = text.strip()
    # Models often close with the bare answer after prose; take the last
    # non-empty line so a correct answer is not marked wrong for being explained.
    lines = [l.strip() for l in got.splitlines() if l.strip()]
    tail = lines[-1] if lines else ""
    norm = lambda s: re.sub(r"[^a-z0-9.\-]", "", s.lower())
    for candidate in (tail, got):
        if norm(spec["answer"]) and norm(spec["answer"]) == norm(candidate):
            return 1.0, "exact match"
    if norm(spec["answer"]) and norm(spec["answer"]) in norm(got):
        return 0.5, "answer present but not isolated"
    return 0.0, f"expected {spec['answer']!r}, tail was {tail[:80]!r}"


def score_json(text, spec):
    """Parse the reply as JSON and check the required shape."""
    raw = _code_block(text).strip()
    m = re.search(r"\{.*\}", raw, re.S)
    if not m:
        return 0.0, "no JSON object in reply"
    try:
        obj = json.loads(m.group(0))
    except json.JSONDecodeError as exc:
        return 0.0, f"invalid JSON: {exc}"
    missing = [k for k in spec["required"] if k not in obj]
    if missing:
        return 0.0, f"missing keys {missing}"
    for key, want in spec.get("values", {}).items():
        if str(obj.get(key)).lower() != str(want).lower():
            return 0.5, f"{key} was {obj.get(key)!r}, expected {want!r}"
    for key, kind in spec.get("types", {}).items():
        if kind == "list" and not isinstance(obj.get(key), list):
            return 0.5, f"{key} is {type(obj.get(key)).__name__}, expected list"
        if kind == "int" and not isinstance(obj.get(key), int):
            return 0.5, f"{key} is {type(obj.get(key)).__name__}, expected int"
    return 1.0, "shape and values correct"


def score_constraints(text, spec):
    """Count how many countable instructions the reply obeyed."""
    body = text.strip()
    lines = [l for l in body.splitlines() if l.strip()]
    checks = []
    if "line_count" in spec:
        checks.append(("line count", len(lines) == spec["line_count"]))
    if "prefix" in spec:
        checks.append(("every line prefixed",
                       all(l.lstrip().startswith(spec["prefix"]) for l in lines)))
    if "suffix" in spec:
        checks.append(("every line suffixed",
                       all(l.rstrip().endswith(spec["suffix"]) for l in lines)))
    if "forbidden_chars" in spec:
        checks.append(("forbidden characters absent",
                       not any(c in body for c in spec["forbidden_chars"])))
    if "forbidden" in spec:
        low = body.lower()
        checks.append(("forbidden words absent",
                       not any(re.search(rf"\b{re.escape(w)}\b", low)
                               for w in spec["forbidden"])))
    if "required_substrings" in spec:
        checks.append(("required substrings present",
                       all(s.lower() in body.lower()
                           for s in spec["required_substrings"])))
    if "max_words" in spec:
        checks.append(("within word budget",
                       len(body.split()) <= spec["max_words"]))
    passed = sum(1 for _, ok in checks if ok)
    failed = [name for name, ok in checks if not ok]
    return passed / len(checks), ("all constraints met" if not failed
                                  else "violated: " + ", ".join(failed))


SCORERS = {"code": score_code, "exact": score_exact,
           "json": score_json, "constraints": score_constraints}


# --------------------------------------------------------------------------
# the suite
# --------------------------------------------------------------------------

def build_suite(retrieval_sentences):
    """Every task, with its category, prompt, token budget, and scorer spec.

    Token budgets are per task rather than global. Qwen3.8 spends most of its
    budget in `reasoning_content`, so a budget sized for the answer alone
    truncates before the answer starts; budgets here are sized for the chain
    plus the answer, and `finish_reason` reports when one was still too small.
    """
    return [
        dict(id="code-rle", category="code", max_tokens=3072,
             prompt="Write a Python function `rle(s)` that returns the run-length "
                    "encoding of a string as a list of (character, count) tuples, "
